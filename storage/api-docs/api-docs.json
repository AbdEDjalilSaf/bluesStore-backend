{
    "openapi": "3.0.0",
    "info": {
        "title": "Shirt Store API",
        "description": "No-login storefront API for a retro football shirt shop. Browse the catalog and shipping wilayas, then place an order without an account. All amounts are in DZD.",
        "contact": {
            "email": "hello@example.com"
        },
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "api"
        }
    ],
    "paths": {
        "/categories": {
            "get": {
                "tags": [
                    "categories"
                ],
                "summary": "List all categories",
                "description": "Returns all categories (public).",
                "operationId": "ead5fb1cf2a7453acb2e37928a1b1eaf",
                "responses": {
                    "200": {
                        "description": "List of categories.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/CategoryCollection"
                                }
                            }
                        }
                    }
                }
            },
            "post": {
                "tags": [
                    "categories"
                ],
                "summary": "Create a category",
                "description": "Create a new category. Validates a unique name (admin).",
                "operationId": "bb02f0320882db37f99574196577e446",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/CategoryRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Category created.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Category"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation failed."
                    }
                }
            }
        },
        "/categories/{id}": {
            "get": {
                "tags": [
                    "categories"
                ],
                "summary": "Get a category",
                "description": "Returns a single category by ID (public).",
                "operationId": "4cdf41756315109f1efc72787db5830a",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "The category.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Category"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Category not found."
                    }
                }
            },
            "delete": {
                "tags": [
                    "categories"
                ],
                "summary": "Delete a category",
                "description": "Delete a category (admin). Block the delete if any products exist.",
                "operationId": "f1b8af6e84bd52b9594d98bde748ebd6",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "204": {
                        "description": "Category deleted."
                    },
                    "404": {
                        "description": "Category not found."
                    },
                    "422": {
                        "description": "Cannot delete category with existing products."
                    }
                }
            },
            "patch": {
                "tags": [
                    "categories"
                ],
                "summary": "Update a category",
                "description": "Update category fields (admin).",
                "operationId": "fad7d7ab8a8e415f1d330c72f3dd6f4e",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/CategoryUpdateRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Category updated.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Category"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Category not found."
                    },
                    "422": {
                        "description": "Validation failed."
                    }
                }
            }
        },
        "/orders": {
            "post": {
                "tags": [
                    "orders"
                ],
                "summary": "Place an order",
                "description": "Guest checkout. Prices are computed on the server and stock is decremented inside a transaction. Throttled to 5 requests per minute.",
                "operationId": "445bab4f7dc9ea6fcd54f286c0209478",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/OrderRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Order placed.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Order"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation failed, an item is unavailable, or there is not enough stock."
                    },
                    "429": {
                        "description": "Too many requests."
                    }
                }
            }
        },
        "/orders/track": {
            "get": {
                "tags": [
                    "orders"
                ],
                "summary": "Track an order",
                "description": "Returns the status, status timeline, items and totals of an order when the phone and order number both match. Every mismatch returns the same generic 404. Throttled to 5 requests per minute.",
                "operationId": "04ded3f72909c0c5199696d439ad818b",
                "parameters": [
                    {
                        "name": "phone",
                        "in": "query",
                        "description": "Algerian mobile number (0[5-7]XXXXXXXX) used when the order was placed.",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "example": "0550123456"
                        }
                    },
                    {
                        "name": "order_number",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "example": "BC-20261007-AB12"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "The tracked order.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/TrackedOrder"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "No order matches the given phone and order number."
                    },
                    "422": {
                        "description": "The phone or order number is missing or malformed."
                    },
                    "429": {
                        "description": "Too many requests."
                    }
                }
            }
        },
        "/products": {
            "get": {
                "tags": [
                    "products"
                ],
                "summary": "List active products",
                "description": "Paginated product list with filters, searching, sorting and computed fields (discount_percent, in_stock).",
                "operationId": "c1ff6f862214e1896c59cfe0491ce0e8",
                "parameters": [
                    {
                        "name": "team",
                        "in": "query",
                        "description": "Exact team name.",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "category_id",
                        "in": "query",
                        "description": "Exact category id.",
                        "schema": {
                            "type": "integer",
                            "minimum": 1
                        }
                    },
                    {
                        "name": "search",
                        "in": "query",
                        "description": "Search in name and team.",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "sort",
                        "in": "query",
                        "schema": {
                            "type": "string",
                            "enum": [
                                "newest",
                                "price_asc",
                                "price_desc",
                                "year"
                            ]
                        }
                    },
                    {
                        "name": "page",
                        "in": "query",
                        "schema": {
                            "type": "integer",
                            "minimum": 1
                        }
                    },
                    {
                        "name": "per_page",
                        "in": "query",
                        "schema": {
                            "type": "integer",
                            "maximum": 100,
                            "minimum": 1
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Paginated list of products.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProductCollection"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Invalid filter value."
                    }
                }
            },
            "post": {
                "tags": [
                    "products"
                ],
                "summary": "Create a product",
                "description": "Create a product and, when images are sent, store them on the public disk and create their rows in the same transaction (admin).",
                "operationId": "399770d33fa4672f1216707d0e236763",
                "requestBody": {
                    "required": true,
                    "content": {
                        "multipart/form-data": {
                            "schema": {
                                "$ref": "#/components/schemas/ProductRequest"
                            }
                        },
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/ProductRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Product created.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Product"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation failed."
                    }
                }
            }
        },
        "/products/{key}": {
            "get": {
                "tags": [
                    "products"
                ],
                "summary": "Show a product",
                "description": "Returns a single active product, resolved by id or slug.",
                "operationId": "647b4d640353d30a3ba785c57d2b2464",
                "parameters": [
                    {
                        "name": "key",
                        "in": "path",
                        "description": "Product id or slug.",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "The product.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Product"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Product not found or inactive."
                    }
                }
            },
            "delete": {
                "tags": [
                    "products"
                ],
                "summary": "Delete a product",
                "description": "Delete a product by id or slug. Removes its image rows and stored image files (admin).",
                "operationId": "0a5faf514c129a314e2ead769e118c4e",
                "parameters": [
                    {
                        "name": "key",
                        "in": "path",
                        "description": "Product id or slug.",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "204": {
                        "description": "Product deleted."
                    },
                    "404": {
                        "description": "Product not found."
                    }
                }
            },
            "patch": {
                "tags": [
                    "products"
                ],
                "summary": "Update a product",
                "description": "Update product fields by id or slug and append uploaded images (admin).",
                "operationId": "271b53142e0d54a28717998374accc61",
                "parameters": [
                    {
                        "name": "key",
                        "in": "path",
                        "description": "Product id or slug.",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "multipart/form-data": {
                            "schema": {
                                "$ref": "#/components/schemas/ProductUpdateRequest"
                            }
                        },
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/ProductUpdateRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Product updated.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Product"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Product not found."
                    },
                    "422": {
                        "description": "Validation failed."
                    }
                }
            }
        },
        "/wilayas": {
            "get": {
                "tags": [
                    "wilayas"
                ],
                "summary": "List shipping wilayas",
                "description": "Returns all active shipping destinations with their phone prefix and delivery fee.",
                "operationId": "83f864e07d3885acd54237c0ccddcf4d",
                "responses": {
                    "200": {
                        "description": "List of active wilayas.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/WilayaCollection"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "CategoryRequest": {
                "required": [
                    "name"
                ],
                "properties": {
                    "name": {
                        "type": "string",
                        "example": "Club Jerseys",
                        "maxLength": 255
                    }
                },
                "type": "object"
            },
            "OrderRequest": {
                "required": [
                    "customer_name",
                    "phone",
                    "wilaya_id",
                    "items"
                ],
                "properties": {
                    "customer_name": {
                        "type": "string",
                        "example": "Karim Benali"
                    },
                    "phone": {
                        "description": "Algerian mobile number (0[5-7]XXXXXXXX).",
                        "type": "string",
                        "example": "0550123456"
                    },
                    "wilaya_id": {
                        "description": "ID of an active wilaya.",
                        "type": "integer",
                        "example": 16
                    },
                    "items": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/OrderItemRequest"
                        }
                    }
                },
                "type": "object"
            },
            "OrderItemRequest": {
                "required": [
                    "product_id"
                ],
                "properties": {
                    "product_id": {
                        "description": "ID of an active product. Send one entry per unit ordered.",
                        "type": "integer",
                        "example": 1
                    }
                },
                "type": "object"
            },
            "ProductRequest": {
                "required": [
                    "name",
                    "slug",
                    "team",
                    "year",
                    "description",
                    "price",
                    "stock"
                ],
                "properties": {
                    "name": {
                        "type": "string",
                        "example": "Nigeria 1994 Home Shirt",
                        "maxLength": 255
                    },
                    "slug": {
                        "description": "Unique url-safe slug.",
                        "type": "string",
                        "example": "nigeria-1994-home-shirt",
                        "maxLength": 255
                    },
                    "team": {
                        "type": "string",
                        "example": "Nigeria",
                        "maxLength": 255
                    },
                    "year": {
                        "type": "integer",
                        "example": 1994,
                        "maximum": 2100,
                        "minimum": 1900
                    },
                    "description": {
                        "type": "string",
                        "example": "Classic home shirt with gold trim."
                    },
                    "price": {
                        "description": "Price in DZD.",
                        "type": "integer",
                        "example": 4500,
                        "minimum": 0
                    },
                    "old_price": {
                        "type": "integer",
                        "example": 6000,
                        "nullable": true,
                        "minimum": 0
                    },
                    "stock": {
                        "type": "integer",
                        "example": 10,
                        "minimum": 0
                    },
                    "category_id": {
                        "description": "Existing category id.",
                        "type": "integer",
                        "example": 1,
                        "nullable": true
                    },
                    "is_active": {
                        "type": "boolean",
                        "default": true
                    },
                    "images": {
                        "description": "Image uploads. Requires a multipart/form-data request.",
                        "type": "array",
                        "items": {
                            "type": "string",
                            "format": "binary"
                        }
                    }
                },
                "type": "object"
            },
            "CategoryUpdateRequest": {
                "properties": {
                    "name": {
                        "type": "string",
                        "example": "National Teams",
                        "maxLength": 255
                    }
                },
                "type": "object"
            },
            "ProductUpdateRequest": {
                "properties": {
                    "name": {
                        "type": "string",
                        "example": "Nigeria 1994 Home Shirt",
                        "maxLength": 255
                    },
                    "slug": {
                        "description": "Unique url-safe slug.",
                        "type": "string",
                        "example": "nigeria-1994-home-shirt",
                        "maxLength": 255
                    },
                    "team": {
                        "type": "string",
                        "example": "Nigeria",
                        "maxLength": 255
                    },
                    "year": {
                        "type": "integer",
                        "example": 1994,
                        "maximum": 2100,
                        "minimum": 1900
                    },
                    "description": {
                        "type": "string",
                        "example": "Classic home shirt with gold trim."
                    },
                    "price": {
                        "description": "Price in DZD.",
                        "type": "integer",
                        "example": 4500,
                        "minimum": 0
                    },
                    "old_price": {
                        "type": "integer",
                        "example": 6000,
                        "nullable": true,
                        "minimum": 0
                    },
                    "stock": {
                        "type": "integer",
                        "example": 10,
                        "minimum": 0
                    },
                    "category_id": {
                        "description": "Existing category id.",
                        "type": "integer",
                        "example": 1,
                        "nullable": true
                    },
                    "is_active": {
                        "type": "boolean"
                    },
                    "images": {
                        "description": "Additional image uploads, appended to the existing ones. Requires a multipart/form-data request.",
                        "type": "array",
                        "items": {
                            "type": "string",
                            "format": "binary"
                        }
                    }
                },
                "type": "object"
            },
            "Category": {
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "name": {
                        "type": "string"
                    },
                    "created_at": {
                        "type": "string"
                    },
                    "updated_at": {
                        "type": "string"
                    }
                },
                "type": "object"
            },
            "CategoryCollection": {
                "properties": {
                    "data": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/Category"
                        }
                    },
                    "links": {
                        "type": "object"
                    },
                    "meta": {
                        "type": "object"
                    }
                },
                "type": "object"
            },
            "OrderItem": {
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "product_id": {
                        "type": "integer"
                    },
                    "product_name": {
                        "type": "string"
                    },
                    "unit_price": {
                        "type": "integer"
                    }
                },
                "type": "object"
            },
            "Order": {
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "order_number": {
                        "type": "string",
                        "example": "BC-20261007-AB12"
                    },
                    "customer_name": {
                        "type": "string"
                    },
                    "phone": {
                        "type": "string"
                    },
                    "wilaya": {
                        "type": "string"
                    },
                    "subtotal": {
                        "type": "integer"
                    },
                    "shipping_fee": {
                        "type": "integer"
                    },
                    "total": {
                        "type": "integer"
                    },
                    "status": {
                        "type": "string",
                        "enum": [
                            "pending",
                            "confirmed",
                            "shipped",
                            "delivered",
                            "cancelled"
                        ]
                    },
                    "items": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/OrderItem"
                        }
                    },
                    "created_at": {
                        "type": "string"
                    }
                },
                "type": "object"
            },
            "OrderStatusChange": {
                "properties": {
                    "status": {
                        "type": "string",
                        "enum": [
                            "pending",
                            "confirmed",
                            "shipped",
                            "delivered",
                            "cancelled"
                        ]
                    },
                    "changed_at": {
                        "type": "string",
                        "example": "2026-10-07T14:03:00.000000Z"
                    }
                },
                "type": "object"
            },
            "TrackedOrder": {
                "properties": {
                    "order_number": {
                        "type": "string",
                        "example": "BC-20261007-AB12"
                    },
                    "status": {
                        "type": "string",
                        "enum": [
                            "pending",
                            "confirmed",
                            "shipped",
                            "delivered",
                            "cancelled"
                        ]
                    },
                    "timeline": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/OrderStatusChange"
                        }
                    },
                    "items": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/OrderItem"
                        }
                    },
                    "subtotal": {
                        "type": "integer"
                    },
                    "shipping_fee": {
                        "type": "integer"
                    },
                    "total": {
                        "type": "integer"
                    }
                },
                "type": "object"
            },
            "ProductImage": {
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "path": {
                        "type": "string"
                    },
                    "sort_order": {
                        "type": "integer"
                    },
                    "is_primary": {
                        "type": "boolean"
                    }
                },
                "type": "object"
            },
            "Product": {
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "name": {
                        "type": "string"
                    },
                    "slug": {
                        "type": "string"
                    },
                    "team": {
                        "type": "string"
                    },
                    "year": {
                        "type": "integer"
                    },
                    "description": {
                        "type": "string"
                    },
                    "price": {
                        "type": "integer"
                    },
                    "old_price": {
                        "type": "integer",
                        "nullable": true
                    },
                    "discount_percent": {
                        "type": "integer"
                    },
                    "stock": {
                        "type": "integer"
                    },
                    "in_stock": {
                        "type": "boolean"
                    },
                    "is_active": {
                        "type": "boolean"
                    },
                    "images": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/ProductImage"
                        }
                    },
                    "created_at": {
                        "type": "string"
                    },
                    "updated_at": {
                        "type": "string"
                    }
                },
                "type": "object"
            },
            "ProductCollection": {
                "properties": {
                    "data": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/Product"
                        }
                    },
                    "links": {
                        "type": "object"
                    },
                    "meta": {
                        "type": "object"
                    }
                },
                "type": "object"
            },
            "Wilaya": {
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "name": {
                        "type": "string"
                    },
                    "phone_number": {
                        "type": "string"
                    },
                    "shipping_fee": {
                        "type": "integer"
                    },
                    "is_active": {
                        "type": "boolean"
                    }
                },
                "type": "object"
            },
            "WilayaCollection": {
                "properties": {
                    "data": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/Wilaya"
                        }
                    }
                },
                "type": "object"
            }
        }
    },
    "tags": [
        {
            "name": "products",
            "description": "Shirt catalog"
        },
        {
            "name": "wilayas",
            "description": "Shipping destinations"
        },
        {
            "name": "orders",
            "description": "Guest checkout"
        },
        {
            "name": "categories",
            "description": "categories"
        }
    ]
}